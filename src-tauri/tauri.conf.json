{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DICOM Converter Desktop",
  "version": "1.2.1",
  "identifier": "com.dicomconverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "DICOM Converter Desktop",
      "width": 1180,
      "height": 900,
      "minWidth": 760,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self' asset:; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Medical",
    "shortDescription": "Offline DICOM image converter",
    "longDescription": "Convert images and DICOM files entirely on this device.",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  }
}
